# LLM Provider: claude | openai | ollama
LLM_PROVIDER=claude

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Ollama (local)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
# Optional. Official Ollama cloud web search: https://ollama.com/settings/keys
# If empty, Tool Stash searches via DuckDuckGo and fetches pages locally.
OLLAMA_API_KEY=

# SQLite file. Docker maps ./data -> /data
DATABASE_URL=sqlite:///./data/toolstash.db

# Frontend nginx → backend. This is the URL from *inside the frontend
# container*, not the URL in your browser. Do not use localhost.
# docker compose hardcodes http://backend:8000 and ignores this.
# BACKEND_URL=http://backend:8000
